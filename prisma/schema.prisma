// Production Persistence Layer (Phase 12).
//
// Relational schema for persisting exported personnel data (exports/*.json)
// into PostgreSQL (Supabase-compatible). This schema does NOT change the AI
// pipeline — it is a downstream sink for the JSON the pipeline already
// produces. No UI, no business logic here; just the persistence model.
//
// Idempotency is enforced at the schema level: Officer.officerId is unique
// (upsert key) and each Timeline row is unique per (officerId, sequence), so
// re-importing the same exports creates no duplicate officers or timelines.

// Prisma 7 official generator (Phase 16B). The legacy `prisma-client-js`
// generated into node_modules and left a `node_modules/@prisma/client`
// symlink that the Netlify/OpenNext function bundler cannot re-create
// (EPERM: symlink). The `prisma-client` generator emits plain TS sources to a
// source-tree path instead, so there is no node_modules symlink to bundle.
generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (for migrate/
  // introspection) and the PrismaClient driver adapter (for runtime) — not in
  // this schema file. See lib/database/database.ts and prisma.config.ts.
}

/// One officer. `officerId` is the deterministic id from the knowledge layer
/// (region/source-file), used as the idempotent upsert key.
model Officer {
  id              Int      @id @default(autoincrement())
  officerId       String   @unique
  rank            String
  firstName       String
  lastName        String
  currentPosition String?
  currentUnit     String?
  phone           String?
  careerYears     Int      @default(0)
  qualityScore    Int?
  knowledgeScore  Int?
  region          String?
  confidence      Int?
  // Phase 17B: Google Drive photo identity, preserved from the Drive import
  // metadata (no re-scan, no re-download). All nullable — an officer imported
  // from a non-Drive source (or before this phase) simply has no photo.
  driveFileId     String?
  thumbnailUrl    String?
  webViewUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Phase 20C: optional links to the Organization master data (Phase 20A),
  // resolved from currentUnit/region/timeline text via OrganizationService.
  // Nullable and additive — the existing text fields (region, currentUnit,
  // Timeline.unit) are UNCHANGED and remain the source of truth. SetNull so
  // removing a Region/Battalion/Company can never block or cascade into
  // Officer rows. Never backfilled by this phase.
  regionRef       Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId        Int?
  battalionRef    Battalion?    @relation(fields: [battalionId], references: [id], onDelete: SetNull)
  battalionId     Int?
  companyRef      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       Int?
  // Phase 26B Part C/H: optional link to the top-level Headquarters (see
  // Headquarters model docs). Nullable/additive, same SetNull convention as
  // regionId/battalionId/companyId above.
  headquartersRef Headquarters? @relation(fields: [headquartersId], references: [id], onDelete: SetNull)
  headquartersId  Int?

  // Phase 23A: Officer Profile Workspace — additional contact channels.
  // All nullable/additive; existing `phone`/Phone[] are unchanged and remain
  // the primary phone. These are flat fields (matching the existing
  // phone/region flat-field style) rather than a separate Contact table.
  email       String?
  lineId      String?
  facebookUrl String?
  // Phase 26B Part 5 Part C/I: nickname is shown alongside the other contact
  // channels (Phone/Email/LINE/Facebook/Nickname), not a separate section.
  nickname    String?

  // Phase 26B Part 5 Part G: Personal Information, extending Basic
  // Information. All nullable/additive — every existing officer simply has
  // these unset until a human fills them in; nothing is backfilled or
  // guessed. dateOfBirth is stored as a real DATE (Thai Buddhist Era is a
  // DISPLAY concern only — see thai_date.ts's yearBEToGregorian/
  // yearGregorianToBE — so the column itself is a normal Gregorian date).
  // bloodGroup/rh/maritalStatus/shirtSize/nationality are free-form TEXT
  // (not a DB enum) so the UI's dropdowns can offer curated suggestions
  // while still accepting a "Custom" value, exactly like Rank/Position/Unit
  // already do (see lib/officer_profile/*_options.ts) — never a closed set
  // that could silently blank an imported/edited value outside the list.
  dateOfBirth   DateTime? @db.Date
  bloodGroup    String?
  rh            String?
  maritalStatus String?
  children      Int?
  homeProvince  String?
  shirtSize     String?
  nationality   String?

  // Phase 26B Part 5 Part O (optional improvements — all nullable/additive,
  // no regression risk). Free-form TEXT throughout for the same
  // "curated-suggestion, never a closed set" reason as the Part G fields
  // above. retirementYear/retirementCountdown are intentionally NOT stored
  // columns — Part O labels them "Auto Calculated", so they are derived at
  // read time from dateOfBirth (see lib/officer_profile/retirement.ts),
  // never persisted, so they can never drift from the source date.
  citizenId        String?
  passportNumber   String?
  employeeNumber   String?
  emergencyContact String?
  emergencyPhone   String?
  addressSummary   String?
  currentProvince  String?
  religion         String?
  educationLevel   String?
  weightKg         Float?
  heightCm         Float?
  uniformShoeSize  String?
  hatSize          String?
  jacketSize       String?

  // Phase 45.1: Personnel Master Data Expansion — membership + salary/bank
  // fields, all nullable/additive (every existing officer simply has these
  // unset until a human fills them in; nothing is backfilled or guessed).
  // These are FACTUAL Master Data, never derived Intelligence values — no
  // Salary Intelligence calculation reads or writes them in this phase.
  //
  // academyClass: integer 40-100 (validated at the API layer, not a DB
  // CHECK constraint, matching this schema's existing convention of
  // validating ranges in Zod rather than SQL — see isValidYearBE/isValidDay
  // for the same pattern on Timeline).
  academyClass                 Int?
  // Membership tri-state fields: Boolean? so "unknown" (legacy data) stays
  // NULL and is never silently coerced to false — the UI's three-state
  // control (ใช่/ไม่ใช่/ไม่ระบุ) maps 1:1 to (true/false/null).
  isGpfMember                  Boolean?
  isPoliceFuneralWelfareMember Boolean?
  isCooperativeMember          Boolean?
  cooperativeName              String?
  // Salary level/step are free TEXT (not a DB enum) — the audit found no
  // existing closed vocabulary for these two fields, so (matching Rank/
  // Position's established "curated-suggestion, never a closed set"
  // convention) the UI offers suggestions but never forces one, and no
  // value here is ever guessed from salaryStep (SalaryHistory) or any
  // other Intelligence-derived source.
  salaryLevel                  String?
  currentSalaryStep            String?
  // Salary composition — Decimal(12,2) so satang (2 decimal places) are
  // preserved. netSalary is DERIVED at save time as:
  //   currentSalary + otherSpecialAllowances - cooperativeMonthlyDeduction
  // (รายจ่ายรวม; never trusted from the client). Non-negative amounts and
  // expenses ≤ income are enforced at the API/service layer (see
  // officerProfilePatchSchema / resolveNetSalaryForSave).
  //
  // cooperativeMonthlyDeduction is retained as the persisted field name for
  // backward compatibility; its current business meaning is total monthly
  // deductions.
  currentSalary                Decimal? @db.Decimal(12, 2)
  otherSpecialAllowances       Decimal? @db.Decimal(12, 2)
  cooperativeMonthlyDeduction  Decimal? @db.Decimal(12, 2)
  netSalary                    Decimal? @db.Decimal(12, 2)
  // Bank account number is stored as TEXT (never a numeric type) so leading
  // zeros are preserved exactly as entered — this is the single most
  // important storage decision in this phase; see docs/PERSONNEL_MASTER_DATA_STANDARD.md.
  bankName                     String?
  bankAccountNumber            String?

  // Phase 26A: Official Portrait Architecture. A single pinned pointer to the
  // ProfilePhoto row that is this officer's OFFICIAL portrait — displayed
  // everywhere (header, list, dashboard, search) in preference to any Drive
  // scan/manual match. Nullable: most officers have no official portrait yet,
  // in which case the existing resolver tiers (Manual Upload > Manual Match >
  // Google Drive Portrait > Placeholder) are unchanged. SetNull (not Cascade)
  // so deleting/reassigning a ProfilePhoto row can never cascade into Officer;
  // in practice ProfilePhoto rows are never deleted (portrait history is
  // permanent — see ProfilePhoto.photoType docs), so this should stay set
  // once assigned. officialPortraitId is a real relation (unlike
  // ProfilePhoto.matchedOfficerId's loose string match) because it is a
  // single canonical pointer, not a discovery-time best-guess link.
  officialPortrait   ProfilePhoto? @relation("OfficialPortrait", fields: [officialPortraitId], references: [id], onDelete: SetNull)
  officialPortraitId Int?

  // Phase XX — Manual Personnel Entry (Admin Only). `source` records how the
  // row entered the system: "import" (the existing Drive/AI pipeline — the
  // default, so every pre-existing row is unaffected) or "manual" (created
  // through the new admin-only Create Personnel form). createdBy/updatedBy
  // store the acting AuthUser.id (mirrors the V2 Master* tables' standard
  // createdBy/updatedBy convention); the *Name variants are a denormalized,
  // point-in-time display copy so the UI never needs a join or breaks if the
  // acting user account is later removed. employmentStatus is free-form TEXT
  // (not a DB enum), matching every other Personal Information field's
  // "curated-suggestion, never a closed set" convention. policeServiceNumber
  // (เลขประจำตัวตำรวจ) is a distinct concept from the existing employeeNumber
  // field (เลขประจำตัวเจ้าหน้าที่, Phase 26B) — kept as its own column rather
  // than reusing employeeNumber so the two are never conflated.
  source              String  @default("import")
  createdBy           String?
  createdByName       String?
  updatedBy           String?
  updatedByName       String?
  employmentStatus    String?
  policeServiceNumber String?

  timeline      Timeline[]
  phones        Phone[]
  education     Education[]
  training      Training[]
  salaryHistory SalaryHistory[]
  /// Phase 29A: Officer Document Vault — every document uploaded for this officer.
  documents     OfficerDocument[]
  /// Phase 44: Personnel Capability Intelligence — this officer's skills/competencies.
  skills        OfficerSkill[]

  @@index([rank])
  @@index([currentUnit])
  @@index([phone])
  @@index([lastName])
  @@index([headquartersId])
  @@index([regionId])
  @@index([battalionId])
  @@index([companyId])
  @@index([officialPortraitId])
  @@index([citizenId])
  @@index([source])
  @@index([policeServiceNumber])
}

/// One career-timeline row for an officer. Unique per (officer, sequence) so
/// re-import replaces rather than duplicates. `year` is stored as the raw
/// source string (never re-derived here) plus a parsed numeric year when known.
model Timeline {
  id        Int     @id @default(autoincrement())
  officer   Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId Int
  sequence  Int
  year      String
  yearValue Int?
  position  String
  unit      String?

  // Phase 23A: Officer Profile Workspace — editable per-row fields, additive.
  // `rank` is the officer's rank AT THAT POINT in the timeline (may differ
  // from Officer.rank, which is the CURRENT rank) — nullable since existing
  // imported rows never captured a per-entry rank. `source` records where
  // this row's data came from (free text, e.g. "OCR"/"Import"/"AI"/
  // "เจ้าหน้าที่กรอก"/"เจ้าตัวกรอก"/"ตรวจสอบแล้ว"); `verified` is the review
  // status ("ยังไม่ตรวจ" | "ตรวจแล้ว" | "ยืนยันแล้ว", defaulting to
  // unverified). Existing rows (from import) get rank=null/source=null/
  // verified=default — never backfilled, never invented.
  rank     String?
  source   String?
  verified String  @default("ยังไม่ตรวจ")

  // Phase 41 Part 1: structured Position Level (ระดับตำแหน่ง), additive
  // alongside the free-text `position` above (never merged/altered). This is
  // the AUTHORITATIVE, system-wide source of truth for an officer's position
  // level — Commander Search, Dashboard, Statistics, Charts, Timeline &
  // Promotion Intelligence all read this structured value, and after Phase 41
  // nothing derives level from `position` TEXT at runtime again. Stored as
  // one of the closed BPP-scoped strings in lib/commander_query/position_level
  // .ts (POSITION_LEVELS: Unknown / รองสารวัตร / สารวัตร / รองผู้กำกับการ / …
  // / รองผู้บัญชาการ) — a plain string (not a DB enum) so higher command
  // levels can be appended later without a schema migration. Nullable: a
  // pre-Phase-41 row that hasn't been migrated/edited yet is NULL and is
  // treated as "Unknown" by readers; the one-time backfill migration maps
  // known `position` titles into a level and sets the rest to 'Unknown'.
  positionLevel String?

  // Phase 26B Part 3: structured date model, additive alongside the legacy
  // `year` free-text column above (never altered/dropped — every pre-26B row
  // and every Phase 25 import keeps working unchanged). `day`/`month` are
  // nullable (many legacy rows only ever recorded a year); `yearBE` is the
  // Buddhist-Era year as a real integer (distinct from `yearValue`, which is
  // a best-effort parse of the free-text `year` and may hold a Gregorian or
  // otherwise-ambiguous number). `isPresent` marks an ongoing/current
  // position (the "ปัจจุบัน" case) — when true, yearBE/month/day describe the
  // START of that position, not an end date. `effectiveDate` is a real DATE
  // auto-derived from day/month/yearBE (month/day default to 1 when unknown)
  // for sorting/range queries without re-parsing text; NULL until the row is
  // migrated (by the backfill script) or edited through the new date editor.
  day              Int?
  month            Int?
  yearBE           Int?
  // Phase 42A hotfix: Thai Police promotion eligibility follows the
  // appointment cycle (B.E.) rather than raw calendar duration. Nullable so
  // existing rows remain valid; the workspace defaults it from yearBE when a
  // human edits/saves a row.
  appointmentCycle Int?
  isPresent        Boolean   @default(false)
  effectiveDate    DateTime? @db.Date

  // Phase 26B Part C: structured organization hierarchy, additive alongside
  // the legacy free-text `unit` column above (never altered/dropped — every
  // pre-26B row and every Phase 25 import keeps working unchanged). Reuses
  // the EXISTING Region/Battalion/Company master tables (Phase 20A) plus the
  // new Headquarters table (Part H) as the "Border Patrol Division" branch of
  // that hierarchy — no parallel/duplicated organization tables. All
  // nullable/SetNull: a row not yet migrated (or one whose unit doesn't
  // resolve to a registered company/battalion/region) simply has these
  // unset, exactly like `day`/`month`/`yearBE` above for un-migrated dates.
  headquarters   Headquarters? @relation(fields: [headquartersId], references: [id], onDelete: SetNull)
  headquartersId Int?
  regionRef      Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId       Int?
  battalionRef   Battalion?    @relation(fields: [battalionId], references: [id], onDelete: SetNull)
  battalionId    Int?
  companyRef     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId      Int?

  // Phase 49A.2B: free-text labels for each org hierarchy level, additive
  // alongside the id FKs above (never alter/drop `unit` or the id columns).
  // Persist what the user typed/selected so unmatched custom values and
  // exact picker labels round-trip independently of master-data resolve.
  // Null on pre-49A.2B rows; hydrate falls back to resolveLabels(ids).
  headquartersText String?
  regionText       String?
  battalionText    String?
  companyText      String?

  // Phase 49A.3: official appointment order reference ("ตามคำสั่ง") and
  // work-line ("สายงาน") — additive free-text alongside legacy `source`
  // (data provenance) and org labels. Nullable; never overwrite `source`.
  appointmentOrder String?
  workLine         String?

  // Phase 26B Part 5 Part D/H/M: a richer verification TRIAD, additive
  // alongside the existing `verified` free-text status above (never altered
  // — every pre-26B row and reader of `verified` keeps working unchanged).
  // `verificationStatus` is a new, distinct 4-value closed set
  // (VERIFIED/PENDING/REJECTED/NEEDS_REVIEW — see
  // lib/officer_profile/verification_options.ts) rather than a backfilled
  // replacement of `verified`'s 3 Thai strings, so no existing row's
  // meaning is reinterpreted and no backfill/guess is required — a row
  // simply has verificationStatus=null until a human explicitly sets it via
  // the new editor. verifiedBy/verifiedDate/verificationRemark are the
  // supporting audit fields Part H asks for.
  verificationStatus String?
  verifiedBy         String?
  verifiedDate       DateTime? @db.Date
  verificationRemark String?

  @@unique([officerId, sequence])
  @@index([yearValue])
  @@index([unit])
  @@index([effectiveDate])
  @@index([yearBE])
  @@index([appointmentCycle])
  @@index([headquartersId])
  @@index([regionId])
  @@index([battalionId])
  @@index([companyId])
  @@index([verificationStatus])
  @@index([positionLevel])
}

/// Phase 23A: one education record for an officer (year, institution, degree,
/// notes). Independent CRUD rows (not a replace-all timeline) — the UI adds/
/// edits/removes individual rows via id.
model Education {
  id          Int      @id @default(autoincrement())
  officer     Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId   Int
  year        String?
  institution String
  degree      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([officerId])
}

/// Phase 23A: one training-course record for an officer (year, course name,
/// organizing unit, notes). Independent CRUD rows, same convention as Education.
model Training {
  id           Int      @id @default(autoincrement())
  officer      Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId    Int
  year         String?
  course       String
  organization String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([officerId])
}

/// Phase 28A — Career Intelligence Foundation: one salary-step result for an
/// officer for one Buddhist-Era year. Every officer receives exactly one
/// result per year (0.5/1.0/1.5/2.0 steps); `@@unique([officerId, yearBE])`
/// enforces that at the database level. Historical years are preserved
/// permanently — the UI only ever adds/edits/removes individual rows by id
/// (same independent-CRUD-rows convention as Education/Training), never a
/// replace-all timeline, so a prior year's record is never silently
/// regenerated or lost when a later year is edited.
///
/// This table is intentionally minimal (foundation only, per Phase 28A's
/// scope) — no eligibility/warning/AI-suggestion columns exist yet. Future
/// phases (2-step eligibility, promotion readiness, awards, merit reports)
/// are designed to layer on top by READING this table (via
/// career_salary_engine.ts's pure utilities) rather than needing schema
/// changes here.
model SalaryHistory {
  id         Int      @id @default(autoincrement())
  officer    Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId  Int
  yearBE     Int
  salaryStep Float
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([officerId, yearBE])
  @@index([officerId])
}

/// A distinct organizational unit. Deduplicated by unique `name`.
model Unit {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  officerCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([name])
}

/// Phase 19B: a Gallery visual asset (every non-profile image — maps, org
/// charts, deployment/company/battalion layouts, and future visual assets).
/// Independent of the Officer/personnel tables; carries discovery metadata +
/// stored Drive image URLs only (no OCR/AI fields). `assetId` is the
/// deterministic idempotent upsert key. `category` stores the AssetCategory
/// value (e.g. "NEIGHBOR_MAP"); PROFILE assets are never persisted here.
model Asset {
  id           Int       @id @default(autoincrement())
  assetId      String    @unique
  category     String
  region       String?
  company      String?
  battalion    String?
  folderName   String?
  relativePath String
  driveFileId  String?
  thumbnailUrl String?
  webViewUrl   String?
  imageWidth   Int?
  imageHeight  Int?
  createdTime  DateTime?
  updatedTime  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Phase 22A: user-editable metadata fields added by the Metadata Editor.
  // All additive — existing rows default to empty/false; never removes old cols.
  unitName    String?
  unitNumber  String?
  /// Comma-joined keyword list (e.g. "แผนที่,หน่วยข้างเคียง"). UI splits on comma to render chips.
  keywords    String  @default("")
  description String?
  remarks     String?
  verified    Boolean @default(false)

  // Phase 20B: optional link to the authoritative Organization master data
  // (Phase 20A), resolved from the existing `company` text at import time.
  // Nullable and additive — `company`/`battalion`/`region` text fields are
  // unchanged and remain the source of truth for assets that don't resolve
  // to a registered Company. SetNull so removing a Company never blocks or
  // cascades into Assets.
  companyRef Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId  Int?

  @@index([category])
  @@index([region])
  @@index([company])
  @@index([battalion])
  @@index([category, region])
  @@index([category, company])
  @@index([companyId])
  @@index([verified])
  @@index([unitNumber])
}

/// Phase 26B Part C/H: top-level Royal Thai Police organization master data —
/// Headquarters (บช.ตชด., บช.น., ภ.1-9, บช.ก., รร.นรต., ...). `code` is a
/// short stable slug ("BPP", "MPB", "PROV_1", ...), unique. Standalone table
/// (not FK'd FROM Region) — most headquarters entries (รร.นรต., รพ.ตร., ...)
/// have no Region children at all, and Region.headquartersId below is
/// OPTIONAL, so this reuses the existing Region -> Battalion -> Company
/// hierarchy as its "Border Patrol Division" branch (per the explicit
/// instruction: no parallel hierarchy, no duplicated Battalion/Company data)
/// while still supporting every other RTP unit that has no Region at all.
model Headquarters {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  nameTh       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regions   Region[]
  timeline  Timeline[]
  officers  Officer[]
  /// Phase DI-1: DrugCase.headquartersId opposite relation (additive; Headquarters' own behavior is unchanged).
  drugCases DrugCase[]

  @@index([displayOrder])
}

/// Phase 20A: authoritative organization master data — Region. `code` is the
/// bare digit string ("4"), unique. Every Battalion belongs to exactly one
/// Region. This table (not folder/OCR text) is the source of truth every
/// future module (Officers, Gallery, Portfolio, permissions, ...) reads.
model Region {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  nameTh       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 26B Part C/H: optional link to the owning Headquarters (e.g. ภาค4
  // belongs to บช.ตชด.). Nullable/additive — every pre-26B Region row simply
  // has no headquarters yet; nothing about Region's existing behavior,
  // uniqueness, or Battalion relation changes.
  headquarters   Headquarters? @relation(fields: [headquartersId], references: [id], onDelete: SetNull)
  headquartersId Int?

  battalions Battalion[]
  officers   Officer[]
  timeline   Timeline[]
  aliases    OrganizationAlias[]
  /// Phase DI-1: DrugCase.regionId opposite relation (additive).
  drugCases  DrugCase[]

  @@index([headquartersId])
}

/// Phase 20A: authoritative organization master data — Battalion (กก.ตชด.NN).
/// `code` is the 2-digit string ("44"), unique. Belongs to one Region; has
/// many Companies.
model Battalion {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  nameTh       String
  region       Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  regionId     Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies Company[]
  officers  Officer[]
  timeline  Timeline[]
  aliases   OrganizationAlias[]
  /// Phase DI-1: DrugCase.battalionId opposite relation (additive).
  drugCases DrugCase[]

  @@index([regionId])
}

/// Phase 20A: authoritative organization master data — Company (ตชด.NNN).
/// `code` is the 3-digit string ("447"), unique. Belongs to one Battalion.
/// Future Officer/Asset records reference companyId instead of loose text.
model Company {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  nameTh       String
  battalion    Battalion @relation(fields: [battalionId], references: [id], onDelete: Restrict)
  battalionId  Int
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assets    Asset[]
  officers  Officer[]
  timeline  Timeline[]
  aliases   OrganizationAlias[]
  /// Phase DI-1: DrugCase.companyId opposite relation (additive).
  drugCases DrugCase[]

  @@index([battalionId])
}

/// Phase 20A: a raw unit-reference string (from OCR/folder text/imports) that
/// could NOT be confidently mapped to the master Region/Battalion/Company
/// hierarchy. Queued here for manual review instead of polluting the master
/// data with an invented organization record.
model UnresolvedOrganizationCode {
  id           Int      @id @default(autoincrement())
  raw          String
  reason       String
  sourceModule String
  createdAt    DateTime @default(now())

  @@index([sourceModule])
}

/// Phase 27 (Organization Engine): a legacy/OCR-variant/unofficial text form
/// that maps to a real, still-registered Region/Battalion/Company row —
/// distinct from UnresolvedOrganizationCode above, which is for text that
/// maps to NOTHING. An alias exists for text that DOES resolve, just not by
/// exact/normalized match against the canonical row's own code/nameTh (e.g.
/// an observed company code that the official master list doesn't include,
/// or "กองกำกับการตำรวจตระเวนชายแดนที่ 41" for battalion "41").
///
/// Additive only — this table starts EMPTY. No existing Region/Battalion/
/// Company row is altered, relabeled, or removed by adding this table.
/// Populating it (e.g. migrating the organization_seed.ts codes that fall
/// outside the official list into aliases) is a separate, future, dedicated
/// data-migration phase — see lib/organization/organization_engine.ts's
/// module docblock for the full migration plan.
///
/// Exactly one of canonicalRegionId/canonicalBattalionId/canonicalCompanyId
/// is set, matching the level the alias resolves to (never invents a level
/// the alias text didn't specify).
model OrganizationAlias {
  id                   Int        @id @default(autoincrement())
  /// The raw legacy/OCR-variant/unofficial text this alias recognizes.
  aliasText            String
  canonicalRegion      Region?    @relation(fields: [canonicalRegionId], references: [id], onDelete: Cascade)
  canonicalRegionId    Int?
  canonicalBattalion   Battalion? @relation(fields: [canonicalBattalionId], references: [id], onDelete: Cascade)
  canonicalBattalionId Int?
  canonicalCompany     Company?   @relation(fields: [canonicalCompanyId], references: [id], onDelete: Cascade)
  canonicalCompanyId   Int?
  /// Where this alias came from (e.g. "observed-seed-migration", "ocr-variant", "manual") — for audit, not logic.
  source               String
  createdAt            DateTime   @default(now())

  @@index([aliasText])
  @@index([canonicalRegionId])
  @@index([canonicalBattalionId])
  @@index([canonicalCompanyId])
}

/// Phase 21C: a Profile Photo — every image discovered under a Drive
/// "Profile รายบุคคล ..." folder becomes EXACTLY ONE row here, unconditionally,
/// regardless of OCR success, name recognition, or officer-match outcome.
/// Completely independent from Officer (no foreign key) — `matchedOfficerId`
/// is a plain string reference to Officer.officerId, set only when
/// matchStatus is AUTO_MATCHED or MANUAL_MATCHED. Officer.driveFileId/
/// thumbnailUrl/webViewUrl (Phase 17B) are UNCHANGED; this table does not
/// replace them, it is the universal inbox that guarantees no Profile image
/// is ever lost even when it cannot (yet) be linked to an officer.
/// `driveFileId` is the deterministic idempotent upsert key.
model ProfilePhoto {
  id               Int      @id @default(autoincrement())
  driveFileId      String   @unique
  thumbnailUrl     String?
  webViewUrl       String?
  filename         String
  folderPath       String
  region           String?
  company          String?
  battalion        String?
  ocrText          String?
  ocrStatus        String   @default("PENDING")
  matchStatus      String   @default("UNASSIGNED")
  matchedOfficerId String?
  confidence       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Phase 24B-1: Officer Portrait Upload. Additive columns so an uploaded
  // portrait reuses this exact table (no new storage entity). Existing
  // Drive-discovered rows keep these at their defaults/null — unchanged.
  //   sourceType   — where the row came from: "DRIVE_SCAN" (existing inbox
  //                  rows, the default) or "UPLOAD" (portrait uploaded via the
  //                  Officer Profile). Google Drive stays read-only; uploads
  //                  never touch Drive.
  //   storagePath  — Supabase Storage object path for an uploaded portrait
  //                  (null for Drive-scanned rows). The bytes live in Supabase
  //                  Storage; thumbnailUrl/webViewUrl hold the public URLs.
  //   mimeType/width/height — captured image metadata (spec).
  //   uploadedBy   — who uploaded it (free-text actor id; nullable).
  //   isProfile    — whether this is the CURRENT portrait for the linked
  //                  officer. On a new upload the prior current portrait is set
  //                  to false and the new row to true — old portraits are never
  //                  deleted (portrait history).
  sourceType  String  @default("DRIVE_SCAN")
  storagePath String?
  mimeType    String?
  width       Int?
  height      Int?
  uploadedBy  String?
  isProfile   Boolean @default(false)

  // Phase 24B-2: Legacy Portrait Verification. Additive columns — existing
  // rows default to UNKNOWN/null (safe, non-destructive migration).
  //   classification — what the IMAGE ITSELF actually shows, independent of
  //                    matchStatus (who/what it's linked to). Set by a Gallery
  //                    reviewer via the verification UI, or "REAL_PERSON" for
  //                    an officer-uploaded portrait (Phase 24B-1 uploads are
  //                    self-evidently a real portrait). One of:
  //                    REAL_PERSON | PROFILE_CARD | ORGANIZATION | MAP |
  //                    DOCUMENT | UNKNOWN (default). The resolver's
  //                    "Verified Drive Portrait" tier requires
  //                    classification=REAL_PERSON; every other classification
  //                    is EXCLUDED from ever becoming a portrait, regardless
  //                    of matchStatus.
  //   classifiedBy   — reviewer actor id (nullable; null until classified).
  //   classifiedAt   — when the classification was set (nullable).
  classification String    @default("UNKNOWN")
  classifiedBy   String?
  classifiedAt   DateTime?

  // Phase 26A: Official Portrait Architecture. `photoType` records WHAT this
  // image fundamentally IS, independent of `classification` (what the
  // reviewer verified the content shows) and `isProfile`/matchStatus (which
  // one is currently the resolved portrait):
  //   GOOGLE_PROFILE_CARD — the original Drive-scanned profile card (Phase 25
  //                          rebuild default for every existing row). MUST
  //                          NEVER be overwritten or deleted — it is the
  //                          permanent historical document (Part 13).
  //   OFFICIAL_PORTRAIT   — a portrait explicitly designated as the officer's
  //                          official photo (via upload or "Set as Official").
  //   UPLOADED            — a manual upload not (yet) designated official.
  //   OTHER               — anything else (future use).
  // Existing rows all default to GOOGLE_PROFILE_CARD (a safe, accurate
  // backfill — every pre-26A row came from the Phase 25 Drive rebuild); the
  // migration additionally sets photoType=UPLOADED for existing rows whose
  // sourceType is already "UPLOAD" (Phase 24B-1 uploads), so the two columns
  // agree from day one. This column never gates the resolver by itself —
  // `Officer.officialPortraitId` is the single source of truth for "the
  // official portrait"; photoType is descriptive metadata for the gallery/
  // history UI and future classification.
  photoType String @default("GOOGLE_PROFILE_CARD")

  // Opposite side of Officer.officialPortrait (Phase 26A). A ProfilePhoto can
  // be the pinned official portrait of at most one officer.
  officialPortraitOf Officer[] @relation("OfficialPortrait")

  @@index([matchStatus])
  @@index([region])
  @@index([company])
  @@index([battalion])
  @@index([matchedOfficerId])
  @@index([ocrStatus])
  @@index([sourceType])
  // Fast lookup of an officer's current portrait.
  @@index([matchedOfficerId, isProfile])
  @@index([classification])
  @@index([photoType])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 24A: Database V2 Foundation — Master Data (additive, non-destructive).
//
// Per DATABASE_V2_DESIGN.md / MASTER_DATA.md / ER_DIAGRAM.md, the V2
// foundation introduces normalized master tables that are the go-forward
// single source of truth for every future module. They are created ALONGSIDE
// the existing Phase 20A Region/Battalion/Company (Int PK) tables — nothing
// existing is renamed, dropped, or repointed. Legacy tables keep serving
// production unchanged; data migration + FK repointing happen in a later,
// dedicated phase.
//
// V2 conventions (from the authoritative docs, differing from the legacy
// Int-PK/PascalCase tables above ON PURPOSE):
//   • UUID primary keys, DB-generated via gen_random_uuid() (Principle 3).
//   • snake_case table + column names (@@map / @map).
//   • Standard columns on every table: status, version, is_deleted,
//     deleted_at, created_by, updated_by, created_at, updated_at
//     (DATABASE_V2_DESIGN §6).
//   • Every relationship by UUID FK; no text matching (Principle 5).
//   • Soft delete only — no cascade delete (ER_DIAGRAM Cascade Rules).
//
// Model names are prefixed `Master*` so they never collide with the existing
// `Region`/`Battalion`/`Company` Prisma models.
// ─────────────────────────────────────────────────────────────────────────

/// V2 master data — Region (ภาค). Top of the organization tree.
/// Example codes: REGION_1, REGION_2, REGION_SOUTH. (DATABASE_V2_DESIGN §17)
model MasterRegion {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  nameTh       String  @map("name_th")
  nameEn       String? @map("name_en")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  // Standard columns (DATABASE_V2_DESIGN §6)
  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  commands MasterCommand[]

  @@index([isActive])
  @@index([isDeleted])
  @@map("master_regions")
}

/// V2 master data — Command / กองบังคับการ (บก.ตชด.NN). Belongs to one Region.
/// This is the level ABOVE Subdivision that the legacy schema lacked.
/// (DATABASE_V2_DESIGN §18)
model MasterCommand {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region       MasterRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)
  regionId     String       @map("region_id") @db.Uuid
  code         String       @unique
  name         String
  displayOrder Int          @default(0) @map("display_order")
  isActive     Boolean      @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subdivisions MasterSubdivision[]

  @@index([regionId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("master_commands")
}

/// V2 master data — Subdivision / กองกำกับ (กก.ตชด.NN). Belongs to one Command.
/// (DATABASE_V2_DESIGN §19)
model MasterSubdivision {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  command      MasterCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)
  commandId    String        @map("command_id") @db.Uuid
  code         String        @unique
  shortName    String        @map("short_name")
  fullName     String        @map("full_name")
  province     String?
  displayOrder Int           @default(0) @map("display_order")
  isActive     Boolean       @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  companies MasterCompany[]

  @@index([commandId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("master_subdivisions")
}

/// V2 master data — Company / กองร้อย (ร้อย ตชด.NNN). Belongs to one
/// Subdivision. The leaf of the organization tree an officer references.
/// (DATABASE_V2_DESIGN §20)
model MasterCompany {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subdivision   MasterSubdivision @relation(fields: [subdivisionId], references: [id], onDelete: Restrict)
  subdivisionId String            @map("subdivision_id") @db.Uuid
  code          String            @unique
  companyNo     String?           @map("company_no")
  shortName     String            @map("short_name")
  fullName      String            @map("full_name")
  location      String?
  province      String?
  latitude      Decimal?          @db.Decimal(10, 7)
  longitude     Decimal?          @db.Decimal(10, 7)
  displayOrder  Int               @default(0) @map("display_order")
  isActive      Boolean           @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subdivisionId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("master_companies")
}

/// V2 master data — Rank (ยศ). Ordered by `level` (never by text comparison).
/// (DATABASE_V2_DESIGN §22)
model MasterRank {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  nameTh       String  @map("name_th")
  abbreviation String?
  level        Int
  groupName    String? @map("group_name")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([level])
  @@index([isActive])
  @@index([isDeleted])
  @@map("master_ranks")
}

/// V2 master data — Position (ตำแหน่ง). Every position carries a code + Thai
/// name so spellings never diverge. (DATABASE_V2_DESIGN §23, MASTER_DATA Position)
model MasterPosition {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String  @unique
  nameTh        String  @map("name_th")
  positionGroup String? @map("position_group")
  displayOrder  Int     @default(0) @map("display_order")
  isActive      Boolean @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isDeleted])
  @@map("master_positions")
}

/// V2 master data — Timeline Event Type. Every career-timeline event references
/// one of these (no free text). (DATABASE_V2_DESIGN §38)
model MasterTimelineType {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  nameTh       String  @map("name_th")
  nameEn       String? @map("name_en")
  icon         String?
  color        String?
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isDeleted])
  @@map("master_timeline_types")
}

/// V2 master data — Asset Type. Classifies every Asset (Portrait, Map, GP7, …).
/// (DATABASE_V2_DESIGN §51)
model MasterAssetType {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  nameTh       String  @map("name_th")
  nameEn       String? @map("name_en")
  icon         String?
  color        String?
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isDeleted])
  @@map("master_asset_types")
}

/// V2 master data — Document Type (GP7, คำสั่งแต่งตั้ง, …).
/// (DATABASE_V2_DESIGN §52)
model MasterDocumentType {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  nameTh       String  @map("name_th")
  nameEn       String? @map("name_en")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  status    String    @default("ACTIVE")
  version   Int       @default(1)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isDeleted])
  @@map("master_document_types")
}

/// Phase 29A — Officer Document Vault Foundation.
///
/// Generic document record for every official document associated with an
/// officer (National ID, Officer Card, ก.พ.7, Appointment Order, …).
/// The `documentType` column is a free-text code from the built-in list in
/// lib/document/document_types.ts — never a closed DB enum so new types can
/// be added without a schema migration.
///
/// Design:
///   • An officer may have many documents, spanning multiple types.
///   • Each row is one stored file (or a metadata-only placeholder when
///     `storagePath` is null — the row records the type was acknowledged but
///     no file has been uploaded yet).
///   • Versioning: `version` increments on replace; `isActive=false` on the
///     superseded row (never deleted — history is permanent).
///   • Storage follows the same Supabase Storage bucket strategy as portrait
///     upload (Phase 24B-1), under a dedicated "documents" bucket.
///     Path template: officers/{officerId}/documents/{documentType}/{uuid}.{ext}
///   • No OCR, no AI, no auto-classification — pure metadata + bytes storage.
///   • Future phases (AI import, OCR, export, commander dashboard) read this
///     table without requiring schema changes here.
model OfficerDocument {
  id               Int       @id @default(autoincrement())
  officer          Officer   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId        Int
  /// Extensible free-text code from lib/document/document_types.ts
  /// (e.g. "NATIONAL_ID", "GP7", "APPOINTMENT_ORDER"). Never a DB enum.
  documentType     String
  /// Human-readable display title (e.g. "บัตรประชาชน นาย สมชาย"). Required.
  title            String
  description      String?
  /// Supabase Storage object path (null for metadata-only rows with no file yet).
  storagePath      String?
  /// Publicly resolvable URL for the stored file; null when storagePath is null.
  fileUrl          String?
  originalFilename String?
  mimeType         String?
  /// File size in bytes; null for metadata-only rows.
  fileSize         Int?
  uploadedAt       DateTime?
  uploadedBy       String?
  verifiedAt       DateTime? @db.Date
  verifiedBy       String?
  /// Phase 47 — Document Expiry Intelligence. All three are optional; a
  /// document with no expiryDate is simply never expiry-tracked (status
  /// "Unknown", never treated as expired). Not every document type uses
  /// these — see lib/document/document_expiry_types.ts for which types are
  /// expiry-enabled.
  issueDate        DateTime? @db.Date
  expiryDate       DateTime? @db.Date
  renewalDate      DateTime? @db.Date
  /// Increments on every replace (first upload = 1). Used to surface "Version N" in history.
  version          Int       @default(1)
  /// false on superseded versions (soft-deleted on replace). True = the current active row for this type.
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([officerId])
  @@index([documentType])
  @@index([isActive])
  @@index([officerId, documentType])
  @@index([officerId, isActive])
  @@index([expiryDate])
}

/// A phone number associated with an officer. Unique per (officer, number).
model Phone {
  id        Int     @id @default(autoincrement())
  officer   Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId Int
  number    String

  @@unique([officerId, number])
  @@index([number])
}

/// One database-import run, for auditing/idempotency reporting.
model ImportJob {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  images     Int       @default(0)
  imported   Int       @default(0)
  skipped    Int       @default(0)
  errors     Int       @default(0)

  logs ImportLog[]
}

/// A per-record log line for an import job (created/updated/skipped/error).
model ImportLog {
  id        Int       @id @default(autoincrement())
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     Int
  officerId String
  action    String
  message   String?
  createdAt DateTime  @default(now())

  @@index([jobId])
  @@index([officerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 44: Personnel Capability Intelligence (ทะเบียนความเชี่ยวชาญและศักยภาพ).
//
// Additive, non-destructive registry of officer skills / competencies /
// certificates / languages / deployment readiness. Follows the LEGACY table
// convention (Int PK, PascalCase) — NOT the V2 master_* UUID convention —
// specifically because OfficerSkill FKs to the legacy Officer.id (Int), the
// same key Timeline/Education/Training/SalaryHistory/OfficerDocument all use.
//
// Three master tables (SkillCategory / Skill / SkillLevel) hold the closed but
// extensible catalog seeded by scripts/seed_skills.ts. OfficerSkill is the
// per-officer join carrying level/experience/verification/deployment. The
// certificate fields are kept INLINE on OfficerSkill for the current
// single-certificate UI, AND a separate OfficerSkillCertificate child table
// exists so a skill can carry MULTIPLE certificates in the future without a
// schema migration (the UI simply starts populating it later).
//
// No existing table, column, or engine is touched.
// ─────────────────────────────────────────────────────────────────────────

/// A top-level skill category (ด้านกฎหมายและงานสืบสวน, ภาษาต่างประเทศ, …).
/// Bilingual by design (Thai primary, English secondary — Phase 43 UI guideline).
model SkillCategory {
  id        Int      @id @default(autoincrement())
  /// Stable slug for idempotent seeding (e.g. "LEGAL", "LANGUAGE", "TECH"). Never shown to users.
  code      String   @unique
  nameTh    String
  nameEn    String
  /// Optional icon name (lucide) for the accordion header.
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]

  @@index([sortOrder])
  @@index([active])
}

/// One skill within a category (ภาษาอังกฤษ, การประยุกต์ใช้ AI, TCCC, …).
model Skill {
  id                  Int           @id @default(autoincrement())
  /// Stable slug for idempotent seeding (e.g. "LANG_EN", "AI_APPLIED"). Never shown to users.
  code                String        @unique
  category            SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId          Int
  nameTh              String
  nameEn              String
  /// Comma-joined free-text keywords to widen search (e.g. "อังกฤษ,english,ล่าม,interpreter"). Split on comma by the search layer.
  searchableKeywords  String        @default("")
  /// Whether this skill typically carries a certificate (drives the UI's certificate fields; never blocks saving).
  requiresCertificate Boolean       @default(false)
  /// Whether this skill's certificate can expire (drives the expiry field + "expiring soon" dashboard).
  hasExpiry           Boolean       @default(false)
  sortOrder           Int           @default(0)
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  officerSkills OfficerSkill[]

  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
}

/// A proficiency level (พื้นฐาน … ครูฝึก/วิทยากร). `rank` gives the order and
/// enables "minimum level ≥ X" search without string comparison. 7 seeded levels.
model SkillLevel {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  nameTh    String
  nameEn    String
  /// 1..7, lowest → highest. Higher = more proficient. Used by "minimum level" search and expert/instructor detection.
  rank      Int      @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officerSkills OfficerSkill[]

  @@index([rank])
}

/// One skill held by one officer. Unique per (officer, skill) — the officer
/// either has a skill (one row) or not. Replace-all on save (same convention as
/// SalaryHistory/Education/Training). Certificate fields are inline for the
/// current single-certificate UI; OfficerSkillCertificate holds the
/// forward-compatible multi-certificate history.
model OfficerSkill {
  id                     Int         @id @default(autoincrement())
  officer                Officer     @relation(fields: [officerId], references: [id], onDelete: Cascade)
  officerId              Int
  skill                  Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId                Int
  /// Proficiency level (nullable — an officer may record a skill before assessing a level).
  level                  SkillLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  levelId                Int?
  yearsExperience        Int?
  /// Inline "primary certificate" fields (current UI). The multi-cert future lives in OfficerSkillCertificate.
  certificateNumber      String?
  issuingOrganization    String?
  issueDate              DateTime?   @db.Date
  expiryDate             DateTime?   @db.Date
  /// Verification triad (same shape as Timeline's verification — a closed Bool + who/when).
  verified               Boolean     @default(false)
  verifiedBy             String?
  verifiedDate           DateTime?   @db.Date
  /// When true, Commander Search / AI can surface "has this skill AND is ready to deploy".
  availableForDeployment Boolean     @default(false)
  remarks                String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  certificates OfficerSkillCertificate[]

  @@unique([officerId, skillId])
  @@index([officerId])
  @@index([skillId])
  @@index([levelId])
  @@index([verified])
  @@index([availableForDeployment])
  @@index([expiryDate])
}

/// Phase 44 forward-compatibility: a single certificate belonging to an
/// OfficerSkill. The current UI writes ONE certificate (the inline fields on
/// OfficerSkill), but this child table lets a skill accumulate MANY
/// certificates later with no schema change — future UI simply reads/writes
/// rows here. Starts empty; nothing depends on it yet.
model OfficerSkillCertificate {
  id                  Int          @id @default(autoincrement())
  officerSkill        OfficerSkill @relation(fields: [officerSkillId], references: [id], onDelete: Cascade)
  officerSkillId      Int
  certificateNumber   String?
  issuingOrganization String?
  issueDate           DateTime?    @db.Date
  expiryDate          DateTime?    @db.Date
  remarks             String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([officerSkillId])
  @@index([expiryDate])
}

// ── Phase 51.3 — Telegram identity binding & durable bot state ─────────────
// App principals remain AuthUser ids from the AuthBackend (e.g. mock:bpp414).
// No second role system; telegramUsername is metadata only (never authorization).

enum TelegramBindingStatus {
  PENDING_VERIFICATION
  ACTIVE
  REVOKED
  DISABLED
}

/// Binding of Telegram numeric user id → existing AuthUser.id
model TelegramIdentityBinding {
  id                String                @id @default(cuid())
  telegramUserId    String                @unique
  appUserId         String
  status            TelegramBindingStatus
  telegramUsername  String?
  telegramFirstName String?
  createdAt         DateTime              @default(now())
  verifiedAt        DateTime?
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  disabledAt        DateTime?

  @@index([appUserId, status])
  @@index([status])
  @@map("telegram_identity_binding")
}

/// Short-lived, single-use binding tokens (store hash only).
model TelegramBindingToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  appUserId  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([appUserId])
  @@index([expiresAt])
  @@map("telegram_binding_token")
}

/// Durable Telegram conversation session (safe interaction state only).
model TelegramBotSession {
  telegramUserId String   @id
  chatId         String
  payloadJson    String
  schemaVersion  Int      @default(1)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@map("telegram_bot_session")
}

/// Webhook update_id deduplication with TTL.
model TelegramProcessedUpdate {
  updateId  String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("telegram_processed_update")
}

/// Short-lived Web handoff after Telegram dashboard/profile actions.
model TelegramWebHandoff {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  appUserId   String
  destination String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@map("telegram_web_handoff")
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE DI-1 — Drug Intelligence Core Data Model & Case Workspace
// ═════════════════════════════════════════════════════════════════════════
//
// A NEW module inside the SAME app/database — not a second system. Reuses:
//   - Auth: AuthUser.id strings (e.g. "mock:admin") for every actor/recordedBy
//     field, exactly like Officer.createdBy/updatedBy above. No second login,
//     no second role system, no second permission model — see
//     lib/auth/roles.ts's new drug.read/drug.create/drug.edit/drug.admin
//     permissions (Section 20).
//   - Organization: the legacy Region/Battalion/Company/Headquarters tables
//     ABOVE (Phase 20A/26B) — DrugCase references them via nullable FK,
//     exactly like Officer/Timeline do, never a parallel org hierarchy. The
//     V2 master_* UUID tables are NOT referenced (unused elsewhere in the
//     app today — see DATABASE_V2_DESIGN.md; wiring them in is a separate,
//     system-wide migration outside this module's scope).
//   - Database client: the SAME PrismaClient/DatabaseClient — no second
//     database, no second connection.
//
// Model naming: every model is prefixed `Drug*` so it can never collide with
// an existing Personnel/Officer/Telegram model name, and so a `grep "model
// Drug"` instantly enumerates the whole module's schema surface.
//
// IDs: cuid() (matching the Telegram tables' convention for new, non-legacy
// modules — see TelegramIdentityBinding above) rather than Int autoincrement
// (the legacy Officer/Timeline convention) or UUID (the V2 master_*
// convention this module deliberately does not adopt). A fresh choice for a
// fresh module; never mixed with Officer's Int PKs since nothing here FKs
// into Officer by numeric id (DrugCasePerson links by Officer.officerId
// STRING when a case subject is a known officer — see below — never by the
// numeric Officer.id, so Officer's schema/PK never has to change for this
// module to exist).
//
// ENTITY + CASE/EVENT + RELATIONSHIP (Section 2): DrugCase is the event.
// DrugPerson/DrugPhoneNumber/DrugSim/DrugDevice/DrugVehicle/DrugLocation are
// entities. Every entity-to-entity or entity-to-case link that matters for
// future graph/network analysis (Section 23) is its own row with
// sourceCaseId + firstSeenAt/lastSeenAt + status + recordedBy (Section 12),
// never a foreign key alone and never a flattened person_1/person_2 column
// (Section 5) or a phone1/phone2 column (Section 6).
//
// NOT implemented in DI-1 (Section 28): SOCIAL_ACCOUNT, FINANCIAL_ACCOUNT,
// ORGANIZATION/GROUP, DOCUMENT entities; automatic Person merge; graph
// traversal; map/heatmap. The schema below does not close the door on any of
// these — DrugRelationship's entityType/entityId design (see below) can
// target a future entity type by adding one string constant, no migration.

/// Provenance/confidence triad shared by every relationship-shaped table in
/// this module (Section 13). `SYSTEM_SUGGESTED` must never be presented as
/// confirmed (Section 13 — enforced at the UI/service layer, not the DB).
enum DrugRelationshipStatus {
  CONFIRMED
  OBSERVED
  REPORTED
  SYSTEM_SUGGESTED
}

/// A person's role within one case (Section 5). Free-standing enum (not
/// reused from Personnel — Officer has no equivalent "role in an event"
/// concept) so this module's vocabulary can grow independently.
enum DrugCasePersonRole {
  SUSPECT
  ACCUSED
  ARRESTED_PERSON
  ASSOCIATED_PERSON
  WITNESS
  OTHER
}

/// Section 3: identifier TYPE — never assume every person has a Thai
/// national ID. UNKNOWN is a first-class value (Section 3: "ยังไม่ทราบตัวตน").
enum DrugPersonIdentifierType {
  THAI_ID
  PASSPORT
  ALIEN_ID
  OTHER
  UNKNOWN
}

/// Section 10: a Location's conceptual ROLE within a case — never inferred,
/// always explicit, and never implies two people at the same location share
/// a network (Section 10's explicit prohibition).
enum DrugLocationRole {
  ARREST_LOCATION
  RESIDENCE
  STORAGE_LOCATION
  MEETING_POINT
  OTHER
}

/// Section 4/16: a case's lifecycle status. Free string in the UI layer's
/// Zod validation (not a DB CHECK) matching this schema's established
/// "validate ranges/sets in Zod, not SQL" convention (see Timeline/Officer
/// above) — but a real Postgres enum here because, unlike Rank/Position,
/// there is no "preserve an arbitrary imported legacy value" concern: every
/// DrugCase is created through this module's own form, never through an
/// external import pipeline that could hand back an out-of-vocabulary value.
enum DrugCaseStatus {
  OPEN
  UNDER_INVESTIGATION
  CLOSED
  ARCHIVED
}

/// Section 4: one arrest/case event. The root of the module — every other
/// Drug* entity ultimately traces back to at least one DrugCase through a
/// DrugCase* junction/relationship row (Section 23's graph-edge list).
///
/// Organization is referenced through the SAME legacy Region/Battalion/
/// Company/Headquarters tables Officer/Timeline already use (nullable FK,
/// SetNull on delete — identical convention to Officer.regionId etc. above)
/// — never a duplicated free-text unit name (spec Section 4 explicit
/// instruction). reportingUnitText/battalionText/companyText are kept
/// alongside the FKs (same "id + free-text label" pairing Timeline's
/// headquartersText/regionText/... already established) so a unit that
/// doesn't resolve to a registered master-data row is never silently
/// dropped or forced into the wrong record.
model DrugCase {
  id         String         @id @default(cuid())
  /// Human-facing case number (e.g. "ตชด.44-2569-001"). Not globally unique
  /// by design — different units may use overlapping local numbering
  /// schemes; officerId-style global uniqueness would force a numbering
  /// convention this module has no authority to impose. Duplicate-case
  /// safety instead comes from the application-layer duplicate check
  /// (Section 14), never a DB unique constraint on this human-entered field.
  caseNumber String
  title      String
  status     DrugCaseStatus @default(OPEN)

  arrestDate DateTime? @db.Date
  arrestTime String?

  headquarters      Headquarters? @relation(fields: [headquartersId], references: [id], onDelete: SetNull)
  headquartersId    Int?
  region            Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId          Int?
  battalion         Battalion?    @relation(fields: [battalionId], references: [id], onDelete: SetNull)
  battalionId       Int?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId         Int?
  reportingUnitText String?

  province     String?
  district     String?
  subdistrict  String?
  locationName String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  narrative String?

  createdBy     String
  createdByName String
  updatedBy     String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  persons       DrugCasePerson[]
  phones        DrugCasePhone[]
  sims          DrugCaseSim[]
  devices       DrugCaseDevice[]
  vehicles      DrugCaseVehicle[]
  seizedItems   DrugSeizedItem[]
  locations     DrugCaseLocation[]
  relationships DrugRelationship[] @relation("RelationshipSourceCase")

  @@index([caseNumber])
  @@index([status])
  @@index([arrestDate])
  @@index([province])
  @@index([headquartersId])
  @@index([regionId])
  @@index([battalionId])
  @@index([companyId])
  @@index([createdBy])
}

/// Section 3: a real, internally-identified person. Never keyed by national
/// ID (explicit prohibition) — `id` is the only identity, and it is stable
/// even for a person with zero identifiers on file yet (Section 3: "ยังไม่
/// ทราบตัวตน" — an unidentified person is still exactly one DrugPerson row,
/// just with no DrugPersonIdentifier children).
///
/// `primaryFullName` is a display convenience (list/search columns need a
/// name to sort/render immediately without a join) — the AUTHORITATIVE name
/// history/aliases live in DrugPersonAlias below, never flattened into
/// name_1/name_2 columns (Section 3).
model DrugPerson {
  id              String    @id @default(cuid())
  primaryFullName String
  nationality     String?
  dateOfBirth     DateTime? @db.Date
  notes           String?

  /// DI-2 Section 16: entity-resolution lifecycle state. ACTIVE is the
  /// canonical, normal state every DI-1 person was created in. MERGED means
  /// this row lost a merge review and now only exists for traceability —
  /// every service/UI query that lists "real" persons (directory, search,
  /// duplicate candidates, Create Case reuse) must filter to ACTIVE, while
  /// mergedIntoPersonId lets any old reference (a stale bookmark, a Case
  /// Workspace drawer opened before the merge) redirect to the surviving
  /// canonical record instead of 404ing. Never hard-deleted (Section 16:
  /// "ไม่ควรถูก hard delete แบบหายไป") — MERGED rows are the trace.
  status             DrugPersonStatus @default(ACTIVE)
  mergedIntoPerson   DrugPerson?      @relation("PersonMergedInto", fields: [mergedIntoPersonId], references: [id], onDelete: SetNull)
  mergedIntoPersonId String?
  mergedFromPersons  DrugPerson[]     @relation("PersonMergedInto")

  createdBy     String
  createdByName String
  updatedBy     String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  identifiers          DrugPersonIdentifier[]
  aliases              DrugPersonAlias[]
  cases                DrugCasePerson[]
  phones               DrugCasePhone[] // via association, see below (person is on the case-phone link, not directly here)
  devices              DrugPersonDevice[]
  vehicles             DrugPersonVehicle[]
  relationshipsFrom    DrugRelationship[]     @relation("RelationshipFromPerson")
  /// Opposite side of DrugCaseSim.person / DrugCaseDevice.person /
  /// DrugCaseVehicle.person — required by Prisma for every relation to be a
  /// declared pair. Not intended for eager per-person iteration in DI-1 (the
  /// per-case sighting rows are queried from the Case side); declared here
  /// purely to satisfy the schema and keep the door open for a future
  /// "every sighting of this person" query with no migration needed.
  caseSimSightings     DrugCaseSim[]
  caseDeviceSightings  DrugCaseDevice[]       @relation("CaseDevicePerson")
  caseVehicleSightings DrugCaseVehicle[]      @relation("CaseVehiclePerson")

  /// DI-2: merge history rows where this person was the surviving canonical
  /// record, and rows where this person was absorbed into another.
  mergesAsSurvivor DrugPersonMerge[] @relation("MergeSurvivor")
  mergesAsMerged   DrugPersonMerge[] @relation("MergeMerged")

  /// DI-2: persistent match-review decisions this person is one half of
  /// (never re-derived per pair — see DrugPersonMatchReview's own comment).
  matchReviewsAsA DrugPersonMatchReview[] @relation("MatchReviewPersonA")
  matchReviewsAsB DrugPersonMatchReview[] @relation("MatchReviewPersonB")

  @@index([primaryFullName])
  @@index([dateOfBirth])
  @@index([status])
  @@index([mergedIntoPersonId])
}

/// DI-2 Section 16.
enum DrugPersonStatus {
  ACTIVE
  MERGED
}

/// Section 3: one identifier for a person — a person may have MANY (a Thai
/// ID discovered later, an alien ID from before naturalization, etc.), and
/// (deliberately, per Section 14) two different DrugPerson rows are allowed
/// to carry the SAME identifier value until an analyst explicitly resolves
/// the conflict in a future phase — this table never enforces uniqueness on
/// (type, value), because doing so would silently block the exact "possible
/// duplicate, needs human review" case DI-2's matching engine is meant to
/// surface, not something the schema should pre-empt by rejecting the insert.
model DrugPersonIdentifier {
  id       String                   @id @default(cuid())
  person   DrugPerson               @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  type     DrugPersonIdentifierType
  value    String
  notes    String?

  createdBy String
  createdAt DateTime @default(now())

  @@index([personId])
  @@index([type, value])
}

/// Section 3: one name/alias for a person over time. `isPrimary` marks which
/// alias backs DrugPerson.primaryFullName's display copy (denormalized for
/// list rendering — never the other way around: this table is the source of
/// truth, primaryFullName is a cache updated when the primary alias changes).
model DrugPersonAlias {
  id        String     @id @default(cuid())
  person    DrugPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  fullName  String
  isPrimary Boolean    @default(false)

  createdBy String
  createdAt DateTime @default(now())

  @@index([personId])
  @@index([fullName])
}

/// Section 5: the Case↔Person junction, carrying the person's ROLE in that
/// specific case (never person_1/person_2/person_3 columns on DrugCase).
/// One person can appear in many cases; one case can have many persons.
model DrugCasePerson {
  id       String             @id @default(cuid())
  case     DrugCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  person   DrugPerson         @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  role     DrugCasePersonRole

  /// Section 5 note: when the arrested/associated person is ALSO a known
  /// police Officer (e.g. an internal corruption case), this optionally
  /// links to the existing Personnel record by its STRING business key
  /// (Officer.officerId) — never a numeric FK, so this module never forces a
  /// migration/lock on the Officer table, and Personnel is completely
  /// unaffected whether or not this field is ever populated (nullable,
  /// unindexed by the Officer side — no reverse relation added to Officer).
  linkedOfficerId String?

  notes String?

  createdBy String
  createdAt DateTime @default(now())

  @@unique([caseId, personId])
  @@index([caseId])
  @@index([personId])
  @@index([linkedOfficerId])
}

/// Section 6: a normalized phone number as its own entity — never
/// person.phone1/phone2 columns. `normalizedNumber` is the matching key
/// (E.164-ish digits only, e.g. "66812345678"); `rawInputs` is NOT stored as
/// a column here (a phone number is shared across many observations with
/// many original spellings) — each case-linking row below keeps its own
/// original-input text instead, so the canonical entity itself never
/// prefers one formatting over another.
model DrugPhoneNumber {
  id               String  @id @default(cuid())
  normalizedNumber String  @unique
  notes            String?

  createdBy String
  createdAt DateTime @default(now())

  caseLinks DrugCasePhone[]
  simLinks  DrugSimPhoneHistory[]

  @@index([normalizedNumber])
}

/// Section 6/12: the relationship edge "this Person used/was associated with
/// this Phone Number, observed via this Case" — carries the full provenance
/// triad (Section 12: source case, first/last seen, status, recordedBy) so
/// no permanent "owns" conclusion is ever implied by a single sighting
/// (Section 12's explicit prohibition). `originalInput` preserves exactly
/// what was typed/found (e.g. "081-234-5678") independently of
/// DrugPhoneNumber.normalizedNumber, per Section 6's "keep original input if
/// useful" note. This is simultaneously the Case↔Phone AND Person↔Phone edge
/// (a phone is always observed FOR a person WITHIN a case — there is no
/// scenario in this module where a case references a bare phone number with
/// no associated person, so one junction row captures both edges without
/// forcing a redundant second table).
model DrugCasePhone {
  id            String          @id @default(cuid())
  case          DrugCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String
  person        DrugPerson      @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId      String
  phoneNumber   DrugPhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  phoneNumberId String
  originalInput String?

  status      DrugRelationshipStatus @default(REPORTED)
  firstSeenAt DateTime?              @db.Date
  lastSeenAt  DateTime?              @db.Date
  confidence  Int?
  recordedBy  String
  notes       String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([personId])
  @@index([phoneNumberId])
  @@index([status])
}

/// Section 7: a SIM card as its own entity, distinct from DrugPhoneNumber
/// (a SIM can be re-provisioned onto a different number over its life; the
/// module tracks that as history, not a single fixed field).
model DrugSim {
  id      String  @id @default(cuid())
  iccid   String? @unique
  imsi    String?
  carrier String?
  notes   String?

  createdBy String
  createdAt DateTime @default(now())

  caseLinks     DrugCaseSim[]
  phoneHistory  DrugSimPhoneHistory[]
  deviceHistory DrugSimDeviceHistory[]

  @@index([iccid])
  @@index([imsi])
}

/// Section 7: "Phone Number may have a history of SIMs" / a SIM may change
/// number — the temporal join between DrugSim and DrugPhoneNumber. Every row
/// is a historical fact, never overwritten; `validTo=null` means "current as
/// of lastSeenAt/now".
model DrugSimPhoneHistory {
  id            String          @id @default(cuid())
  sim           DrugSim         @relation(fields: [simId], references: [id], onDelete: Cascade)
  simId         String
  phoneNumber   DrugPhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  phoneNumberId String
  validFrom     DateTime?       @db.Date
  validTo       DateTime?       @db.Date
  sourceCaseId  String?
  recordedBy    String
  createdAt     DateTime        @default(now())

  @@index([simId])
  @@index([phoneNumberId])
}

/// Section 7/12: the Case↔SIM edge — same provenance triad as DrugCasePhone,
/// same "SIM found WITH a person in a case" combined edge shape.
model DrugCaseSim {
  id       String      @id @default(cuid())
  case     DrugCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  person   DrugPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId String?
  sim      DrugSim     @relation(fields: [simId], references: [id], onDelete: Cascade)
  simId    String

  status      DrugRelationshipStatus @default(REPORTED)
  firstSeenAt DateTime?              @db.Date
  lastSeenAt  DateTime?              @db.Date
  recordedBy  String
  notes       String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([personId])
  @@index([simId])
}

/// Section 8: a physical device (handset), distinct from any single Person
/// or SIM — the SAME device may be seen with different people in different
/// years (Section 8's explicit example), which is exactly why Person↔Device
/// and SIM↔Device are their own time-aware relationship tables below, never
/// a device.ownerId column.
model DrugDevice {
  id           String  @id @default(cuid())
  brand        String?
  model        String?
  serialNumber String?
  imei1        String?
  imei2        String?
  notes        String?

  createdBy String
  createdAt DateTime @default(now())

  personLinks DrugPersonDevice[]
  simHistory  DrugSimDeviceHistory[]
  caseLinks   DrugCaseDevice[]

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
}

/// Section 8/12: Person↔Device, full provenance triad — the durable "was
/// this device associated with this person" fact, independent of any one
/// case (a device can be linked to a person across multiple cases; this row
/// aggregates the relationship, DrugCaseDevice below records EACH sighting).
model DrugPersonDevice {
  id       String     @id @default(cuid())
  person   DrugPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  device   DrugDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String

  status       DrugRelationshipStatus @default(REPORTED)
  firstSeenAt  DateTime?              @db.Date
  lastSeenAt   DateTime?              @db.Date
  sourceCaseId String?
  recordedBy   String
  notes        String?

  createdAt DateTime @default(now())

  @@index([personId])
  @@index([deviceId])
}

/// Section 7/8: "SIM may change device" — the temporal join, same pattern as
/// DrugSimPhoneHistory.
model DrugSimDeviceHistory {
  id           String     @id @default(cuid())
  sim          DrugSim    @relation(fields: [simId], references: [id], onDelete: Cascade)
  simId        String
  device       DrugDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  validFrom    DateTime?  @db.Date
  validTo      DateTime?  @db.Date
  sourceCaseId String?
  recordedBy   String
  createdAt    DateTime   @default(now())

  @@index([simId])
  @@index([deviceId])
}

/// Section 8/12: the Case↔Device edge — one row per sighting of a device
/// within a case (distinct from DrugPersonDevice's aggregate relationship).
model DrugCaseDevice {
  id       String      @id @default(cuid())
  case     DrugCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  person   DrugPerson? @relation(fields: [personId], references: [id], onDelete: SetNull, name: "CaseDevicePerson")
  personId String?
  device   DrugDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId String

  status     DrugRelationshipStatus @default(REPORTED)
  recordedBy String
  notes      String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([personId])
  @@index([deviceId])
}

/// Section 9: a vehicle entity — one vehicle can relate to many
/// Persons/Cases (Section 9's explicit requirement), so linkage lives in
/// DrugPersonVehicle/DrugCaseVehicle below, never a single ownerId column.
model DrugVehicle {
  id                   String  @id @default(cuid())
  registrationNumber   String?
  registrationProvince String?
  vehicleType          String?
  brand                String?
  model                String?
  color                String?
  vin                  String?
  notes                String?

  createdBy String
  createdAt DateTime @default(now())

  personLinks DrugPersonVehicle[]
  caseLinks   DrugCaseVehicle[]

  @@index([registrationNumber])
  @@index([vin])
  /// DI-3 Section 26: DrugEntityRepository.findOrCreateVehicle already
  /// queries by (registrationNumber, registrationProvince) TOGETHER (a plate
  /// number alone isn't unique nationally — the same plate text can exist in
  /// different provinces), but only single-column indexes existed until now.
  /// Global Search's vehicle-registration lookup uses this exact same
  /// composite shape, so the query need is real, not speculative.
  @@index([registrationNumber, registrationProvince])
}

/// Section 9/12: Person↔Vehicle, full provenance triad (same shape as
/// DrugPersonDevice — an aggregate relationship, independent of any one
/// case; DrugCaseVehicle records each sighting).
model DrugPersonVehicle {
  id        String      @id @default(cuid())
  person    DrugPerson  @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  vehicle   DrugVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  status       DrugRelationshipStatus @default(REPORTED)
  firstSeenAt  DateTime?              @db.Date
  lastSeenAt   DateTime?              @db.Date
  sourceCaseId String?
  recordedBy   String
  notes        String?

  createdAt DateTime @default(now())

  @@index([personId])
  @@index([vehicleId])
}

/// Section 9/12: the Case↔Vehicle edge.
model DrugCaseVehicle {
  id        String      @id @default(cuid())
  case      DrugCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  person    DrugPerson? @relation(fields: [personId], references: [id], onDelete: SetNull, name: "CaseVehiclePerson")
  personId  String?
  vehicle   DrugVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  status     DrugRelationshipStatus @default(REPORTED)
  recordedBy String
  notes      String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([personId])
  @@index([vehicleId])
}

/// Section 10: a location, with an explicit conceptual ROLE (never inferred
/// — Section 10's explicit prohibition on assuming shared-location implies
/// shared-network). A location entity itself is reusable across cases (the
/// same address may be an ARREST_LOCATION in one case and a RESIDENCE in
/// another); DrugCaseLocation below is the per-case, per-role linking row.
model DrugLocation {
  id          String   @id @default(cuid())
  name        String?
  addressText String?
  province    String?
  district    String?
  subdistrict String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  notes       String?

  createdBy String
  createdAt DateTime @default(now())

  caseLinks DrugCaseLocation[]

  @@index([province])
  @@index([district])
}

/// Section 10/12: the Case↔Location edge, carrying the ROLE this location
/// played in THIS case (the same DrugLocation row can carry a different role
/// in a different case — role lives here, not on DrugLocation itself).
model DrugCaseLocation {
  id         String           @id @default(cuid())
  case       DrugCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  location   DrugLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  role       DrugLocationRole

  recordedBy String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([locationId])
  @@index([role])
}

/// Phase DI-3.1: the canonical, aggregatable drug classification — never a
/// free-text string a dashboard would have to GROUP BY and hope spelling
/// variants don't fragment totals. Mirrors this module's own established
/// convention (DrugCaseStatus/DrugCasePersonRole/DrugPersonIdentifierType/
/// DrugLocationRole: a real Postgres enum, because every DrugSeizedItem is
/// created through this module's own Create Case form, never round-tripped
/// through an external import pipeline that could hand back an
/// out-of-vocabulary value). OTHER is the deliberate escape hatch for a
/// substance not yet catalogued — DrugSeizedItem.otherDrugCategoryLabel
/// carries the free-text description in that case, so a new substance never
/// blocks case entry and never needs a same-day migration.
enum DrugCategory {
  METHAMPHETAMINE_TABLET
  CRYSTAL_METHAMPHETAMINE
  HEROIN
  KETAMINE
  MDMA
  COCAINE
  OPIUM
  CANNABIS
  OTHER
}

/// Phase DI-3.1: which physical quantity a seized-item row's numbers mean —
/// resolves the exact ambiguity a free-text `unit` column left open (a
/// dashboard could not previously know, without parsing display text,
/// whether to sum `quantity` or `weightGrams` for a given row, or whether
/// two rows' totals were even addable). COUNT items are summed via
/// `quantity` (discrete units — tablets, packages). MASS items are summed
/// via `weightGrams` (the single canonical mass unit — see
/// DrugSeizedItem.weightGrams). A COUNT row's weightGrams and a MASS row's
/// quantity are never populated together — enforced in Zod, not the DB,
/// matching this schema's established "validate combinations in Zod, not a
/// CHECK constraint" convention (see DrugCaseStatus's doc comment).
enum DrugMeasurementKind {
  COUNT
  MASS
}

/// Section 11: one seized-item line on a case. Deliberately NOT a set of
/// drugType1/drugType2/... columns on DrugCase (Section 11's explicit
/// prohibition) — a case adds as many rows here as needed.
///
/// Phase DI-3.1: `drugCategory`/`measurementKind` are the CANONICAL
/// analytics keys a future Commander Dashboard (DI-8) aggregates by —
/// closed sets, never free text. `drugType`/`subtype`/`notes` remain the
/// EVIDENCE fields: whatever the officer actually recorded, verbatim,
/// preserved even when it doesn't match the canonical label exactly (e.g.
/// "ยาไอซ์บรรจุถุงชาเขียว จำนวน 12 ถุง"). Aggregation always reads
/// drugCategory/measurementKind; display of what-was-recorded always reads
/// drugType/subtype/notes. Never conflate the two — that conflation is
/// exactly the gap this migration closes.
model DrugSeizedItem {
  id       String   @id @default(cuid())
  case     DrugCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String

  /// Canonical aggregation key (Phase DI-3.1). Required — every new row
  /// must classify into the catalog, using OTHER when nothing else fits.
  drugCategory           DrugCategory
  /// Free-text description, populated ONLY when drugCategory = OTHER — the
  /// substance name for a not-yet-catalogued drug, never itself an
  /// aggregation key (Section 3's explicit instruction).
  otherDrugCategoryLabel String?
  /// COUNT (sum via quantity) or MASS (sum via weightGrams) — resolves
  /// which of the two numeric fields below is the aggregatable one for
  /// this row (Section 4).
  measurementKind        DrugMeasurementKind

  /// As-recorded evidence text — what the officer actually typed (e.g.
  /// "ยาบ้า", "ไอซ์บรรจุถุงชาเขียว"). Never the aggregation key; preserved
  /// verbatim even when drugCategory normalizes it (Section 6).
  drugType     String
  subtype      String?
  /// Populated when measurementKind = COUNT (discrete units — tablets,
  /// packages, etc.). The as-recorded unit label lives in `unit` below;
  /// this is the number that gets summed for COUNT aggregation.
  quantity     Decimal? @db.Decimal(12, 3)
  /// As-recorded unit label for a COUNT row (e.g. "เม็ด", "ถุง") — display
  /// only, never parsed to infer measurementKind (Section 4's explicit
  /// prohibition on inferring semantics from display strings).
  unit         String?
  /// Populated when measurementKind = MASS. Canonical mass unit is ALWAYS
  /// grams — never store kilograms separately; the UI/API convert
  /// kilogram input to grams before persistence, and the presentation
  /// layer converts back to kilograms for display (Section 4).
  weightGrams  Decimal? @db.Decimal(12, 3)
  packageCount Int?
  notes        String?

  createdBy String
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([drugType])
  @@index([drugCategory])
}

/// Section 12/23: a GENERIC graph edge between any two entities in this
/// module, for relationships that don't already have a dedicated join table
/// above (e.g. Person↔Person "associate of", Person↔Case beyond the
/// DrugCasePerson role link, or a future entity type added in DI-2+ without
/// a schema migration). `fromType`/`fromId` and `toType`/`toId` are a loose
/// polymorphic pair (string discriminator + string id, matching this
/// module's cuid() ids uniformly) rather than a set of nullable FK columns
/// per possible entity type — Section 23 requires the schema to support
/// arbitrary graph edges (Person→Case, Person→Phone, Person→Device, ...)
/// WITHOUT a redesign when new entity types are added; a fixed FK-per-type
/// table would need a new column (and a migration) for every future entity,
/// which is exactly what this generic shape avoids. Every edge still carries
/// the full Section 12/13 provenance triad and traces back to `sourceCase`.
///
/// The dedicated junction tables above (DrugCasePerson, DrugCasePhone, ...)
/// remain the PRIMARY, strongly-typed way to record the six relationship
/// kinds DI-1 actually implements (Section 23's explicit edge list) — they
/// give referential integrity and are what DI-1's own UI reads/writes. This
/// table exists so DI-5 (Interactive Link Analysis) has ONE place to query
/// every edge type uniformly when building a graph, without hand-joining
/// six different tables — DI-1 does not populate it yet (Section 28: no
/// full graph UI this phase), but nothing about its shape blocks a future
/// service from projecting the typed junction tables into rows here, or
/// writing directly into it for edge kinds that have no dedicated table.
model DrugRelationship {
  id               String @id @default(cuid())
  fromType         String
  fromId           String
  toType           String
  toId             String
  relationshipType String

  status      DrugRelationshipStatus @default(SYSTEM_SUGGESTED)
  firstSeenAt DateTime?              @db.Date
  lastSeenAt  DateTime?              @db.Date
  confidence  Int?
  recordedBy  String
  notes       String?

  sourceCase   DrugCase?   @relation("RelationshipSourceCase", fields: [sourceCaseId], references: [id], onDelete: SetNull)
  sourceCaseId String?
  /// Convenience reverse relation when fromType="PERSON" (lets Prisma eager-load a person's outbound generic edges without a raw query); toType-side lookups go through fromId/toId string matching instead, since a polymorphic "to" side can't be a typed Prisma relation.
  fromPerson   DrugPerson? @relation("RelationshipFromPerson", fields: [fromId], references: [id], map: "DrugRelationship_fromPerson_fkey")

  createdAt DateTime @default(now())

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([relationshipType])
  @@index([sourceCaseId])
  @@index([status])
}

/// Section 21: a generic, append-only audit trail for the whole Drug
/// Intelligence module (no reusable generic audit log exists elsewhere in
/// this codebase today — see the DI-1 audit report). One row per action;
/// never updated or deleted. `entityType`/`entityId` name what changed
/// (e.g. "DrugCase"/caseId, "DrugPerson"/personId); `detail` is a short
/// human-readable summary, never raw PII beyond what the entity reference
/// already implies.
model DrugAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actorName  String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE DI-2 — Entity Resolution / Duplicate Matching (additive only).
//
// Nothing above this line was changed except: DrugPerson gained `status` +
// `mergedIntoPersonId` (Section 16 — a person is never hard-deleted by a
// merge, only marked MERGED with a pointer to the survivor) and their two
// new reverse relations into the models below. No existing column, index,
// or relation was removed or retyped, so this migration is purely additive
// on top of the DI-1 schema audited at the start of this phase.
// ─────────────────────────────────────────────────────────────────────────

/// Section 19: the persistent decision a human reviewer made about ONE
/// unordered pair of persons — so the matching engine never re-surfaces a
/// pair the same or another reviewer already resolved. `personAId`/`personBId`
/// are always stored with the lexicographically smaller id first (enforced
/// in the service layer, not the DB) so the @@unique constraint catches the
/// pair regardless of which person the matching engine happened to name
/// "from" vs. "to" on a later run.
model DrugPersonMatchReview {
  id       String @id @default(cuid())
  personA  DrugPerson @relation("MatchReviewPersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personAId String
  personB  DrugPerson @relation("MatchReviewPersonB", fields: [personBId], references: [id], onDelete: Cascade)
  personBId String

  decision DrugPersonMatchDecision

  /// Snapshot of the matching signals that produced this review pair at
  /// decision time (Section 11/12 — human-readable reasons, e.g.
  /// ["identifier:THAI_ID", "nameAndDateOfBirth"]), stored as a JSON array
  /// of strings so the review queue/history can still explain "why this
  /// pair was suggested" even after later data edits change the live signal
  /// set. Never used to RE-derive a verdict — matching always re-runs live.
  signals Json

  reviewedBy     String
  reviewedByName String
  reviewedAt     DateTime @default(now())
  notes          String?

  @@unique([personAId, personBId])
  @@index([personAId])
  @@index([personBId])
  @@index([decision])
}

/// Section 19: outcome vocabulary for a match-review decision.
/// NEEDS_REVIEW is never stored as a row's decision — it's the matching
/// engine's live "no persistent decision exists yet for this pair" state,
/// represented by the ABSENCE of a DrugPersonMatchReview row, not a value
/// of this enum. CONFIRMED_DUPLICATE without an accompanying merge is a
/// valid, distinct state from MERGED (Section 19: a reviewer can confirm
/// two records represent the same person while deferring the actual merge
/// operation to later — Section 15's merge flow is a separate, heavier step).
enum DrugPersonMatchDecision {
  CONFIRMED_DUPLICATE
  NOT_SAME
  MERGED
}

/// Section 16: one completed merge operation — the durable trace of
/// "mergedPerson was merged into survivorPerson". Never deleted or updated
/// after creation (append-only, like DrugAuditLog). `detail` carries a JSON
/// snapshot of the merged person's pre-merge state (aliases/identifiers/
/// case count/etc.) specifically so a future administrative Unmerge (DI-2
/// Section 18: not built now, but must not be architecturally foreclosed)
/// has enough information to reconstruct what was absorbed, without relying
/// on DrugPerson.mergedIntoPersonId alone (which only proves the fact of a
/// merge, not its contents at the time).
model DrugPersonMerge {
  id                String @id @default(cuid())
  survivorPerson    DrugPerson @relation("MergeSurvivor", fields: [survivorPersonId], references: [id], onDelete: Cascade)
  survivorPersonId  String
  mergedPerson      DrugPerson @relation("MergeMerged", fields: [mergedPersonId], references: [id], onDelete: Cascade)
  mergedPersonId    String

  reason String?
  /// JSON snapshot: { mergedPerson: {...}, movedCounts: { cases, phones,
  /// sims, devices, vehicles, identifiers, aliases }, skippedDuplicates:
  /// {...} } — see drug_person_merge_service.ts for the exact shape.
  detail Json

  mergedBy     String
  mergedByName String
  mergedAt     DateTime @default(now())

  @@index([survivorPersonId])
  @@index([mergedPersonId])
  @@index([mergedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PHASE DI-6 — Repeat Entity Detection & Intelligence Alerts (additive
// only). Nothing above this line was changed.
// ─────────────────────────────────────────────────────────────────────────

/// Section 10: a PERSISTED alert event — review/dismiss state and alert
/// history must survive across page loads and later data changes, which a
/// purely-recomputed-on-read model cannot provide. Deliberately NOT built
/// on DrugAuditLog (append-only, unstructured `detail: String?`, no
/// lifecycle/severity) and NOT built on DrugRelationship (a graph-edge
/// concept with no alertType/severity/title/lifecycle) — this is its own
/// model, following the same conventions both of those already establish:
/// polymorphic `entityType`/`entityId` (DrugAuditLog/DrugRelationship's
/// pattern) and `reviewedBy`/`reviewedByName` (DrugPersonMatchReview's
/// actor-with-name pattern). `entityId`/`currentCaseId`/`priorCaseIds` are
/// loose string references, never FKs — an alert must remain readable and
/// reviewable even after the referenced case/person is later edited,
/// merged, or (in a future phase) archived; a hard FK with onDelete:Cascade
/// would silently destroy alert history whenever the underlying data
/// changed, defeating the entire purpose of an operational inbox.
model DrugIntelligenceAlert {
  id String @id @default(cuid())

  alertType String
  severity  String
  entityType String
  entityId   String

  title       String
  explanation String

  currentCaseId    String?
  /// JSON array of case ids (string[]) — every prior case (besides
  /// currentCaseId, if any) this entity/person was found in.
  priorCaseIds     Json
  /// JSON array of person ids (string[]), present for entity-type alerts
  /// (phone/sim/device/vehicle) where more than one person is linked —
  /// null for REPEAT_PERSON/HIGH_CONFIDENCE_DUPLICATE, which already name
  /// the person via entityId.
  relatedPersonIds Json?

  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  occurrenceCount Int

  /// Section 11: deterministic dedup key — one meaningful event produces
  /// exactly one alert row, never a fresh duplicate on every re-generation.
  /// Computed as `${alertType}:${entityType}:${entityId}:${currentCaseId ?? "none"}`.
  dedupeKey String @unique

  /// Section 9 lifecycle: NEW -> REVIEWED | DISMISSED. Never deleted on
  /// review/dismiss — DISMISSED means "reviewed and not actionable," never
  /// "the underlying relationship didn't exist."
  status         String  @default("NEW")
  reviewedBy     String?
  reviewedByName String?
  reviewedAt     DateTime?
  dismissReason  String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([currentCaseId])
  @@index([createdAt])
}
